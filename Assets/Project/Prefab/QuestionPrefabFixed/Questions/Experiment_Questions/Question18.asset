  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: Question18
  m_EditorClassIdentifier: 
  questionText: 'Why is the least count of the given paper scale 0.2

    cm?'
  referenceImage: {fileID: 0}
  explanationText: 'The diagonal line from D divides 1 cm in five proportional and
    similar divisions. So the least count = (1

    cm)/5 = 0.2 cm. This is the minimum
    length we can measure with 100% accuracy or to be exact at this scale.'
  options:
  - Since the scale has 30 divisions in 30 cm
  - 'Since the diagonal line from D divides 1 cm into five proportional and similar
    divisions '
  - 'Since the diagonal line from D divides 1 cm into four proportional and similar
    divisions '
  - None of these
  correctOptionIndex: 1
